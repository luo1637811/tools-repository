# 把 fleet.example.com 换成你自己的域名（A 记录指向服务器 IP）
fleet.example.com {
	encode zstd gzip

	# flush_interval -1 必须保留：否则页面的 SSE 实时刷新会被缓冲，只能手动 F5
	reverse_proxy fleet:8787 {
		flush_interval -1
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
