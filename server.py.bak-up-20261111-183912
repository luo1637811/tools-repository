def audit_policy():
    with conn() as c:
        rows = {r["k"]: r["v"] for r in c.execute(
            "SELECT k,v FROM settings WHERE k IN ('audit_days','audit_max')")}
    try:
        days = max(1, int(rows.get("audit_days") or AUDIT_DAYS_DEFAULT))
    except ValueError:
        days = AUDIT_DAYS_DEFAULT
    try:
        cap = max(100, int(rows.get("audit_max") or AUDIT_MAX_DEFAULT))
    except ValueError:
        cap = AUDIT_MAX_DEFAULT
    return days, cap


def audit_archives(limit=12):
    if not os.path.isdir(LOG_DIR):
        return []
    out = []
    for n in sorted(os.listdir(LOG_DIR), reverse=True):
        if n.startswith("audit-") and n.endswith(".jsonl"):
            p = os.path.join(LOG_DIR, n)
            out.append({"name": n, "kb": round(os.path.getsize(p) / 1024.0, 1)})
        if len(out) >= limit:
            break
    return out


def audit_stats():
    with conn() as c:
        total = c.execute("SELECT COUNT(*) FROM audit").fetchone()[0]
        first = c.execute("SELECT ts FROM audit ORDER BY id LIMIT 1").fetchone()
        last = c.execute("SELECT ts FROM audit ORDER BY id DESC LIMIT 1").fetchone()
        per_day = [dict(r) for r in c.execute(
            "SELECT substr(ts,1,10) d, COUNT(*) n FROM audit GROUP BY d ORDER BY d DESC LIMIT 14")]
        kinds = [dict(r) for r in c.execute(
            "SELECT IFNULL(kind,'') k, COUNT(*) n FROM audit GROUP BY k ORDER BY n DESC")]
    days, cap = audit_policy()
    try:
        db_kb = round(os.path.getsize(DB_PATH) / 1024.0, 1)
    except OSError:
        db_kb = 0
    return {"total": total, "oldest": (first["ts"] if first else ""),
            "newest": (last["ts"] if last else ""), "per_day": per_day, "kinds": kinds,
            "days": days, "max": cap, "archives": audit_archives(), "db_kb": db_kb,
            "version": VERSION, "schema": SCHEMA_VERSION, "log_dir": LOG_DIR}


def audit_archive(rows):
    """按月份追加写入 logs/audit-YYYYMM.jsonl，返回写过的文件列表。"""
    if not rows:
        return []
    os.makedirs(LOG_DIR, exist_ok=True)
    buckets = {}
    for r in rows:
        m = (r.get("ts") or "")[:7].replace("-", "") or "unknown"
        buckets.setdefault(m, []).append(r)
    written = []
    for m, items in buckets.items():
        p = os.path.join(LOG_DIR, "audit-%s.jsonl" % m)
        with io.open(p, "a", encoding="utf-8", newline="\n") as fh:
            for r in items:
                fh.write(json.dumps(r, ensure_ascii=False) + "\n")
        written.append(p)
    return written


def prune_audit(days=None, max_rows=None, archive=True, actor="system"):
    """按「天数 + 条数上限」清理，先归档再删；删完写一条系统日志。"""
    d_days, d_cap = audit_policy()
    days = int(days or d_days)
    cap = int(max_rows or d_cap)
    cutoff = (datetime.now() - timedelta(days=days)).strftime("%Y-%m-%d %H:%M:%S")
    with conn() as c:
        old = [dict(r) for r in c.execute(
            "SELECT * FROM audit WHERE ts < ? ORDER BY id", (cutoff,))]
        total = c.execute("SELECT COUNT(*) FROM audit").fetchone()[0]
        rest = total - len(old)
        extra = []
        if rest > cap:
            extra = [dict(r) for r in c.execute(
                "SELECT * FROM audit WHERE ts >= ? ORDER BY id LIMIT ?", (cutoff, rest - cap))]
    rows = old + extra
    if not rows:
        return {"ok": True, "deleted": 0, "kept": total, "days": days, "max": cap,
                "archives": [], "reason": "都在保留范围内"}
    files = audit_archive(rows) if archive else []
    with conn() as c:
        c.executemany("DELETE FROM audit WHERE id=?", [(r["id"],) for r in rows])
    log("归档清理日志", actor, "audit",
        "删除 %d 条（早于 %s 的 %d 条 + 超出上限 %d 条）；保留 %d 天 / 上限 %d；归档 %s"
        % (len(rows), cutoff[:10], len(old), len(extra), days, cap,
           "、".join(os.path.basename(x) for x in files) or "未归档"))
    return {"ok": True, "deleted": len(rows), "kept": total - len(rows), "days": days,
            "max": cap, "archives": [os.path.basename(x) for x in files], "reason": ""}


