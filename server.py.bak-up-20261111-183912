def audit_kind(action):
    """把动作归到四类，方便按类型筛选与统计。"""
    a = action or ""
    if a in ("登录", "退出", "登录失败"):
        return "访问"
    if a.startswith(("新增", "修改", "删除", "保存", "导入", "清零", "改")):
        return "数据"
    if ("密码" in a) or ("人员" in a) or ("模板" in a) or ("标题" in a):
        return "管理"
    return "系统"


RE_PHONE = re.compile(r"(?<!\d)1[3-9]\d{9}(?!\d)")
RE_EMAIL = re.compile(r"([A-Za-z0-9._%+-])[A-Za-z0-9._%+-]*(@[A-Za-z0-9.-]+)")


def mask_text(v):
    """日志里的手机号/邮箱脱敏，避免审计表本身成为隐私泄漏点"""
    t = str(v or "")
    if not t:
        return ""
    t = RE_PHONE.sub(lambda m: m.group(0)[:3] + "****" + m.group(0)[-4:], t)
    t = RE_EMAIL.sub(lambda m: m.group(1) + "***" + m.group(2), t)
    return t


