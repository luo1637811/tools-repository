    def members_list(self, q):
        u = self.need_perm(("roster_view",))
        if not u:
            return
        kw = (q.get("q") or [""])[0].strip()
        field = (q.get("field") or ["all"])[0].strip() or "all"
        if field not in ("all", "id", "name", "org", "faction", "links"):
            return self.err(400, "这个字段不参与查询（只能按 ID / 名称 / 组织 / 隶属 / 关联账号 查）")
        limit = min(500, max(1, int((q.get("limit") or ["200"])[0] or 200)))
        where, args = "", []
        if kw:
            like = "%" + kw + "%"
            if field != "all":
                where = " WHERE IFNULL(%s,'') LIKE ?" % field
                args = [like]
            else:
                # 只搜这五列：电话 / 微信 / QQ / 评级 / 备注 永不参与查询
                cols = ("id", "name", "org", "faction", "links")
                where = " WHERE " + " OR ".join("IFNULL(%s,'') LIKE ?" % c for c in cols)
                args = [like] * len(cols)
        sc = scope_of(u)
        if sc == "org":                      # 只看本组织
            org = str(u.get("org") or "").strip()
            where += (" AND " if where else " WHERE ") + "IFNULL(org,'')=?"
            args.append(org)
        elif sc == "alliance":               # 只看本联合体
            where += (" AND " if where else " WHERE ") + "IFNULL(alliance,'')=?"
            args.append(str(u.get("alliance") or "").strip())
        elif sc == "self":                   # 只看自己（游戏 ID 存在 users.uid）
            where += (" AND " if where else " WHERE ") + "id=?"
            args.append(str(u.get("uid") or "").strip())
        with conn() as c:
            total = c.execute("SELECT COUNT(*) n FROM members" + where, args).fetchone()["n"]
            rows = [dict(r) for r in c.execute(
                "SELECT * FROM members" + where +
                " ORDER BY updated_at DESC, id LIMIT %d" % limit, args).fetchall()]
        allow_pii = pii_ok(u)
        return self.send_json({"ok": True, "total": total, "scope": sc, "pii": allow_pii,
                               "rows": mask_pii(rows, allow_pii)})

