PWD_REQ_MAX = 5          # 同一 IP 每小时最多提交几条
PWD_REQ_WIN = 3600
_PWD_HITS = {}
_PWD_LOCK = threading.Lock()


def pwd_req_allowed(ip):
    """同一来源 1 小时内最多 5 条申请，防止有人拿脚本刷申请。"""
    t = time.time()
    with _PWD_LOCK:
        arr = [x for x in _PWD_HITS.get(ip, []) if t - x < PWD_REQ_WIN]
        if len(arr) >= PWD_REQ_MAX:
            _PWD_HITS[ip] = arr
            return False
        arr.append(t)
        _PWD_HITS[ip] = arr
        return True


def pwd_contact_ok(stored, contact):
    """库里登记了联系方式就必须对得上；没登记则不校验，只记录。

    * 登记的是邮箱（含 @）：忽略大小写，允许填全名；
    * 登记的是手机号：填全号或后 4 位都行；
    * 都没登记：放行（只记录，交给审批的人核实）。
    """
    st = str(stored or "").strip()
    cd = str(contact or "").strip()
    if not st:
        return True
    if not cd:
        return False
    if "@" in st:
        return cd.lower() == st.lower() or cd.lower().split("@")[0] == st.lower().split("@")[0]
    sd = re.sub(r"\D", "", st)
    cdn = re.sub(r"\D", "", cd)
    if not sd:
        return True
    if not cdn:
        return False
    return cdn == sd or (len(cdn) >= 4 and sd.endswith(cdn[-4:]))


class Handler(BaseHTTPRequestHandler):
    server_version = "FleetTool/0.3"
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        pass

    def send_json(self, data, code=200):
        raw = json.dumps(data, ensure_ascii=False).encode("utf-8")
        gz = False
        if len(raw) > 1024 and "gzip" in (self.headers.get("Accept-Encoding") or ""):
            try:
                raw = gzip.compress(raw, 6)
                gz = True
            except Exception:
                gz = False
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        if gz:
            self.send_header("Content-Encoding", "gzip")
            self.send_header("Vary", "Accept-Encoding")
        self.end_headers()
        self.wfile.write(raw)

    def err(self, code, msg):
        self.send_json({"ok": False, "error": msg}, code)

    def require(self, roles=None):
        u = current_user(self)
        if not u:
            self.err(401, "未登录")
            return None
        if roles and u["role"] not in roles:
            self.err(403, "权限不足")
            return None
        return u

    def need_auth(self):
        """写操作的前置校验：必须已登录，且没有「必须先改密码」。"""
        u = current_user(self)
        if not u:
            self.err(401, "未登录")
            return None
        if int(u.get("must_change") or 0):
            self.send_json({"ok": False, "code": "must_change",
                            "error": "请先修改密码，再使用其他功能"}, 403)
            return None
        return u

    def need_perm(self, keys):
        """keys = ('sim','data',...)；admin 直接放行，其余看 perms 交集。"""
        u = current_user(self)
        if not u:
            self.err(401, "未登录")
            return None
        if int(u.get("must_change") or 0):
            self.send_json({"ok": False, "code": "must_change",
                            "error": "请先修改密码，再使用其他功能"}, 403)
            return None
        if u.get("role") == SUPER_ROLE:
            return u   # 管理员 / 超级管理员看全部模块
        have = perms_of(u)
        if have & set(keys):
            return u
        need = "、".join(PERM_LABEL.get(k, k) for k in keys)
        self.err(403, "没有「%s」的权限，找管理员开" % need)
        return None

    def need_conf(self, expect):
        """高危操作二次确认：X-Confirm 头 / ?confirm= / body.confirm 任一等于目标名称/ID。
        HTTP 头只能是 ASCII，中文目标名（账号、档案）必须走 query 或 body，否则编码直接报错。"""
        want = str(expect).strip()
        got = (self.headers.get("X-Confirm") or "").strip()
        if not got:
            try:
                qs = parse_qs(urlparse(self.path).query or "")
                got = ((qs.get("confirm") or [""])[0] or "").strip()
            except Exception:
                got = ""
        if got != want:
            self.send_json({"ok": False, "code": "confirm",
                            "error": "高危操作需要二次确认：请输入「%s」" % expect,
                            "confirm": want}, 409)
            return False
        return True

    def client_ip(self):
        return (self.client_address[0] if self.client_address else "") or "?"

    def body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if not n:
            return {}                 # 允许空体：登出 / 领 ticket 这类没有 payload
        return json.loads(self.rfile.read(n).decode("utf-8") or "{}")

