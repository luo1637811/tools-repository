def ship_scope(ships, u):
    """按数据范围过滤舰船：管理员/超管不过滤；org、alliance 只看本归属或未归属。"""
    role = (u or {}).get("role") or ""
    if role in ("admin", SUPER_ROLE):
        return ships
    sc = scope_of(u)
    if sc not in ("org", "alliance"):
        return ships
    key = "owner_org" if sc == "org" else "owner_alliance"
    mine = str((u or {}).get("org" if sc == "org" else "alliance") or "").strip()
    if not mine:
        return ships
    out = []
    for s in ships:
        own = str(s.get(key) or "").strip()
        if not own or own == mine:
            out.append(s)
    return out


def guess_uid(c, username, phone):
    """登录名或手机号能对上人员档案时返回档案 ID。
    用独立连接、查完立刻关，避免读游标占着事务把后面的写操作卡成 database is locked。"""
    un = str(username or "").strip()
    ph = str(phone or "").strip()
    cc = conn()
    try:
        if un:
            r = cc.execute("SELECT id FROM members WHERE id=?", (un,)).fetchone()
            if r:
                return r["id"]
        for v in (ph, un):
            if v:
                r = cc.execute("SELECT id FROM members WHERE IFNULL(phone,'')=?", (v,)).fetchone()
                if r:
                    return r["id"]
    finally:
        try:
            cc.close()
        except Exception:
            pass
    return ""


