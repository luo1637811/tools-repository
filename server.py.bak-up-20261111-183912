        with conn() as c:
            row = c.execute("SELECT pwd FROM users WHERE id=?", (u["id"],)).fetchone()
        if not row or not check_pwd(old, row["pwd"]):
            return self.err(403, "旧密码不对")
        with conn() as c:
            c.execute("UPDATE users SET pwd=?, must_change=0, pwd_changed_at=?, updated_at=? WHERE id=?",
                      (hash_pwd(new), now(), now(), u["id"]))
