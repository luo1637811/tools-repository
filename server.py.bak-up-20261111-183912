                    continue
            except (TypeError, ValueError):
                pass
        if str(a if a is not None else "") != str(b if b is not None else ""):
            out.append(k)
    return out


def load_bundle():
    """一次性把蓝图/系统/加点/模块/舰载机读出来。"""
    with conn() as c:
        ships = [dict(r, base=j(r["base"])) for r in c.execute("SELECT * FROM ships")]
        for _s in ships:
            _s["size"] = ship_size(_s.get("kind"), _s.get("cls"))
        systems = []
        for r in c.execute("SELECT * FROM systems ORDER BY ship, ord"):
            d = dict(r)
            d["stats"] = j(d.get("stats"))
            d["bays"] = j(d.get("bays")) or []
            _norm = j(d.get("stats_norm"))
            d["norm"] = _norm if isinstance(_norm, dict) else {}
            systems.append(d)
        
        nodes = []
        for r in c.execute("SELECT * FROM nodes ORDER BY sys, cost DESC"):
            d = dict(r)
            d["effect"] = j(d.get("effect"))
            d["costs"] = j(d.get("costs")) or []
            nodes.append(d)
        modules = []
        for r in c.execute("SELECT * FROM modules ORDER BY ship, slot"):
            d = dict(r)
            d["bonus"] = j(d.get("bonus"))
            d["stats"] = j(d.get("stats"))
            d["bays"] = j(d.get("bays"))
            modules.append(d)
        planes = [dict(r, base=j(r["base"]))
                  for r in c.execute("SELECT * FROM planes ORDER BY kind, id")]
        groups = [dict(r) for r in c.execute("SELECT * FROM groups ORDER BY per_unit DESC, id")]
    for s in ships:
        s["systems"] = [x for x in systems if x["ship"] == s["id"]]
        s["modules"] = [x for x in modules if x["ship"] == s["id"]]
        for m in s["modules"]:
            b = m.get("bays")
            if isinstance(b, dict):
                b = [b]
            if not isinstance(b, list):
                b = []
            if not b and (m.get("mkind") or ""):
                b = [{"kind": (m["mkind"] or "").replace("搭载系统", ""),
                      "cap": m.get("cap") or 0,
                      "allow_group": m.get("allow_group") or ""}]
            m["bays"] = [x for x in b if isinstance(x, dict) and (x.get("kind") or x.get("cap"))]
        for sy in s["systems"]:
            sy["nodes"] = [x for x in nodes if x["sys"] == sy["id"]]
        _kind = s.get("kind") or ("超主力舰" if (s.get("cls") or "") in ("航空母舰", "战列巡洋舰") else "")
        # 超主力舰全部可装模块；主力舰里巡洋舰/驱逐舰也能带舱位（同一套模块/舱位机制）
        s["mod_ok"] = _kind == "超主力舰"   # 只有超主力舰能装模块/舱位（与前端 canMod 一致）
    # 舰载机蓝图存在 ships 里（kind=舰载机），补一份和 planes 同形状的条目，
    # 这样 /api/simulate 既认 planes 表的 id，也认舰船表里的舰载机 id。
    have = {p["id"]: p for p in planes}
    for s in ships:
        if (s.get("kind") or "") != "舰载机":
            continue
        b = s.get("base") or {}
        dur = float(b.get("dur") or 0) or 1.0
        cd = float(b.get("cd") or 0)
        volley = float(b.get("ammo") or 0) * float(b.get("atk") or 0)
        dpm = (float(b.get("dmg") or 0) * volley) / max(0.5, dur + cd) * 60
        ehp = (float(b.get("hull") or 0) + float(b.get("shield") or 0)) * \
              (1 + float(b.get("armor") or 0) * 0.002)
        if dpm <= 0:
            # 蓝图没填单发/弹药时，退一步用武器系统的「对舰」预估（本身是每分钟伤害）
            for sy in s.get("systems") or []:
                st = sy.get("stats") or {}
                raw = st.get("对舰") or st.get("对舰预估") or st.get("对舰伤害") or 0
                if isinstance(raw, str):
                    raw = raw.split("/")[0].strip()
                v = num(raw, 0)
                if v > 0:
                    dpm = v
                    break
        is_boat = (s.get("cls") or "") == "护航艇"
        # 蓝图里的舰载机一律：1 架 = 1 舱，忽略游戏内编组（3/6 架一组）
        rec = {"id": s["id"], "name": s["name"],
               "kind": "护航艇" if is_boat else "战机",
               "pgroup": (s.get("pgroup") or "").strip(), "per_group": 1,
               "base": {"dpm": round(dpm, 1), "ehp": round(ehp, 1)},
               "note": "来自蓝图"}
        if s["id"] in have:
            have[s["id"]].update(rec)          # 覆盖 planes 表里的旧占位值
        else:
            planes.append(rec)
    return ships, planes, groups



def current_user(handler):
    auth = handler.headers.get("Authorization") or ""
    token = auth[7:] if auth.startswith("Bearer ") else ""
    if not token:
        return None
    now_ts = int(time.time())
    with conn() as c:
        r = c.execute("SELECT u.*, s.expire AS _exp, s.csrf AS _csrf"
                      " FROM sessions s JOIN users u ON u.id=s.user"
                      " WHERE s.token=? AND s.expire>?", (token, now_ts)).fetchone()
        if not r:
            return None
        if (r["_exp"] or 0) - now_ts < SESSION_HOURS * 3600 // 2:
            c.execute("UPDATE sessions SET expire=? WHERE token=?",
                      (now_ts + SESSION_HOURS * 3600, token))
    d = dict(r)
    d.pop("_exp", None)
    d["_csrf"] = d.pop("_csrf", "") or ""
    return d


