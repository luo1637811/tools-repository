class SSEHub:

    def __init__(self):
        self.clients = []
        self.lock = threading.Lock()

    def add(self):
        q = queue.Queue(maxsize=16)
        with self.lock:
            self.clients.append(q)
        return q

    def drop(self, q):
        with self.lock:
            if q in self.clients:
                self.clients.remove(q)

    def count(self):
        with self.lock:
            return len(self.clients)

    def publish(self, v):
        with self.lock:
            for q in list(self.clients):
                try:
                    q.put_nowait(v)
                except queue.Full:
                    pass


SSE = SSEHub()

