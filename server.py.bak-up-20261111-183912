            if not r or r["status"] != "待处理":
                return self.err(409, "没有可驳回的待处理申请")
            c.execute("""UPDATE pwd_requests SET status='已驳回', handled_at=?, handled_by=?, note=?
                         WHERE id=?""", (now(), me["username"], (data.get("note") or "")[:200], rid))
        log("驳回重置密码", r["username"], "user#%d" % r["user_id"], (data.get("note") or ""))
        return self.send_json({"ok": True})

