_STATIC_CACHE = {}          # (path, mtime_ns, size) -> (raw, gz)


def static_bytes(fp):
    """读静态文件并按内容缓存 gzip 版本，避免 100 人重复压缩。"""
    st = os.stat(fp)
    key = (fp, st.st_mtime_ns, st.st_size)
    hit = _STATIC_CACHE.get(key)
    if hit:
        return hit
    with open(fp, "rb") as f:
        raw = f.read()
    val = (raw, gzip.compress(raw, 6))
    if len(_STATIC_CACHE) > 32:
        _STATIC_CACHE.clear()
    _STATIC_CACHE[key] = val
    return val


