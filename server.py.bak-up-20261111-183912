def pwd_problem(pwd, username=""):
    """返回不合规原因；空串表示通过。"""
    pwd = pwd or ""
    if len(pwd) < 8:
        return "密码至少 8 位"
    if pwd.lower() in PWD_BLACKLIST:
        return "这个密码太常见了，换一个"
    if username and pwd.strip().lower() == str(username).strip().lower():
        return "密码不能和账号一样"
    if re.fullmatch(r"(.)\1+", pwd):
        return "密码不能是同一个字符重复"
    kinds = sum(bool(re.search(p, pwd)) for p in (r"[a-z]", r"[A-Z]", r"[0-9]", r"[^A-Za-z0-9]"))
    if kinds < 2:
        return "密码要至少包含大小写字母、数字、符号中的两类"
    return ""


LOGIN_MAX_FAIL = 5          # 同一 IP + 账号 连续失败几次后锁定
LOGIN_LOCK_SEC = 300        # 锁定时长（秒）
_FAILS = {}
_FAIL_LOCK = threading.Lock()


def login_wait(ip, name):
    key = ((ip or "?"), (name or "").strip().lower())
    now_s = time.time()
    with _FAIL_LOCK:
        cnt, until = _FAILS.get(key, (0, 0))
        if until and until <= now_s:
            _FAILS.pop(key, None)
            return 0
        return int(until - now_s) if until > now_s else 0


def login_failed(ip, name):
    key = ((ip or "?"), (name or "").strip().lower())
    now_s = time.time()
    with _FAIL_LOCK:
        cnt, until = _FAILS.get(key, (0, 0))
        if until and until <= now_s:
            cnt, until = 0, 0
        cnt += 1
        if cnt >= LOGIN_MAX_FAIL:
            until, cnt = now_s + LOGIN_LOCK_SEC, 0
        _FAILS[key] = (cnt, until)
        return int(until - now_s) if until > now_s else 0


def login_ok(ip, name):
    with _FAIL_LOCK:
        _FAILS.pop(((ip or "?"), (name or "").strip().lower()), None)


