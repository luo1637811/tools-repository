            return
        if table == "ships":
            data = _normalize_ship(dict(data))
        u = self.need_perm(("data_edit",))
        if not u:
            return
        if table not in TABLES:
            return self.err(404, "unknown table")
        pk, cols = TABLES[table]
        row = {}
        for c in cols:
            if c in data:
                row[c] = data[c]
        if not row.get(pk):
            return self.err(400, "缺少主键 " + pk)
        if table == "effects" and "effects_edit" not in perms_of(u):
            return self.err(403, "效果库影响全站计算，需要「效果库·改」权限")
        if table == "ships" and (u.get("role") or "") not in ("admin", SUPER_ROLE):
            _sc = scope_of(u)
            if _sc == "org":
                row["owner_org"] = str(u.get("org") or "").strip()
            elif _sc == "alliance":
                row["owner_alliance"] = str(u.get("alliance") or "").strip()
        for c in JSON_COLS.get(table, []):
            if c in row and not isinstance(row[c], str):
                row[c] = json.dumps(row[c], ensure_ascii=False)
        with conn() as c:
            old = c.execute(f"SELECT * FROM {table} WHERE {pk}=?", (row[pk],)).fetchone()
            if old:
                payload = {k: v for k, v in row.items() if k != pk}
                diff = diff_keys(old, payload)
                if not diff:
                    return self.send_json({"ok": True, "id": row[pk],
                                           "action": "无变化", "changed": 0})
                sets = ",".join(f"{k}=?" for k in diff)
                c.execute(f"UPDATE {table} SET {sets} WHERE {pk}=?",
                          [row[k] for k in diff] + [row[pk]])
                act = "修改数据"
            else:
                c.execute(f"INSERT INTO {table}({','.join(row)}) VALUES({','.join('?' * len(row))})",
                          list(row.values()))
                act = "新增数据"
                diff = list(row.keys())
        bump_version()
        log(act, u["username"], f"{table}/{row[pk]}", "、".join(diff))
        return self.send_json({"ok": True, "id": row[pk], "action": act, "changed": len(diff)})

