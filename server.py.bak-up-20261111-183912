    def pwd_request(self, data):
        """免登录提交重置申请：用户名 + 联系方式 + 原因。

        任何账号（包括 admin）都能提；但批准环节有额外规则：
          * 不能批准自己的申请；
          * admin 的申请只有 admin 能批；
          * 唯一管理员忘密码只能走命令行 --reset-pwd。
        """
        un = (data.get("username") or "").strip()
        contact = (data.get("contact") or "").strip()
        reason = (data.get("reason") or "").strip()[:200]
        if not un or not contact:
            return self.err(400, "请填用户名和联系方式")
        ip = (self.client_address[0] if self.client_address else "") or "?"
        if not pwd_req_allowed(ip):
            return self.err(429, "提交太频繁（同一网络每小时最多 5 条），稍后再试")
        with conn() as c:
            row = c.execute("SELECT id, phone FROM users WHERE username=?", (un,)).fetchone()
            if not row:
                return self.err(404, "没有这个账号")
            if not pwd_contact_ok(row["phone"], contact):
                return self.err(403, "联系方式与账号登记的不一致：请填登记时的手机号（或它的后 4 位）")
            pend = c.execute("SELECT id FROM pwd_requests WHERE user_id=? AND status='待处理'",
                             (row["id"],)).fetchone()
            if pend:
                return self.err(409, "这个账号已经有一条待处理申请，等管理员处理")
            c.execute("""INSERT INTO pwd_requests(user_id,username,reason,status,created_at,note)
                         VALUES(?,?,?,'待处理',?,?)""",
                      (row["id"], un, reason, now(), contact))
        log("申请重置密码", un, "pwd_request", contact)
        return self.send_json({"ok": True})

    def pwd_approve(self, rid, data):
        if not self.need_perm(("people_edit",)):
            return
        if self.need_auth() is None:
            return
        pw = (data.get("password") or "").strip()
        bad = pwd_problem(pw)
        if bad:
            return self.err(400, "临时密码不合规：" + bad)
        me = current_user(self)
        with conn() as c:
            r = c.execute("SELECT * FROM pwd_requests WHERE id=?", (rid,)).fetchone()
            if not r:
                return self.err(404, "申请不存在")
            if r["status"] != "待处理":
                return self.err(409, "这条申请已经处理过了")
            tgt = c.execute("SELECT * FROM users WHERE id=?", (r["user_id"],)).fetchone()
            if not tgt:
                return self.err(404, "账号已不存在")
            if tgt["username"] == me["username"]:
                return self.err(403, "不能批准自己的密码重置申请，请找其他管理员处理")
            if tgt["role"] in ("admin", SUPER_ROLE):
                if (me.get("role") or "") not in ("admin", SUPER_ROLE):
                    return self.err(403, "只有管理员能重置管理员密码")
                n = c.execute("SELECT COUNT(*) n FROM users WHERE role IN ('admin','superadmin')").fetchone()["n"]
                if n <= 1:
                    return self.err(403, "这是唯一的管理员账号，网页里批不了：请在服务器上停掉服务，执行 python server.py --reset-pwd %s" % tgt["username"])
            c.execute("DELETE FROM sessions WHERE user=?", (tgt["id"],))
            c.execute("UPDATE users SET pwd=?, must_change=1, updated_at=? WHERE id=?",
                      (hash_pwd(pw), now(), tgt["id"]))
            c.execute("""UPDATE pwd_requests SET status='已批准', handled_at=?, handled_by=?, note=?
                         WHERE id=?""", (now(), me["username"], (data.get("note") or "")[:200], rid))
        log("批准重置密码", tgt["username"], "user#%d" % tgt["id"], "临时密码，需下次登录修改")
        return self.send_json({"ok": True})

    def pwd_reject(self, rid, data):
        if not self.need_perm(("people_edit",)):
            return
        if self.need_auth() is None:
            return
        me = current_user(self)
        with conn() as c:
