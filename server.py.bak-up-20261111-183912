                "SELECT field, COUNT(*) n FROM member_history WHERE member_id=? GROUP BY field", (mid,))}
            rows = [dict(r) for r in c.execute(
                "SELECT * FROM member_history " + where + " ORDER BY ts DESC, id DESC LIMIT ? OFFSET ?",
                args + [limit, offset]).fetchall()]
            mem = c.execute("SELECT name, org FROM members WHERE id=?", (mid,)).fetchone()
        allow = pii_ok(u)
        if not allow:
            for r in rows:
