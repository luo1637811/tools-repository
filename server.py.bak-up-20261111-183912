    CSRF_EXEMPT = ("/api/login", "/api/register/send", "/api/register/verify", "/api/pwd/request")

    def guard_csrf(self, path):
        """双提交校验：写请求必须带与会话匹配的 X-CSRF。返回 True 表示已拦下。"""
        if path in self.CSRF_EXEMPT or path.startswith("/api/health"):
            return False
        u = current_user(self)
        if not u:
            return False                       # 未登录：交给各处理器回 401
        have = (u.get("_csrf") or "").strip()
        want = (self.headers.get("X-CSRF") or "").strip()
        if not have:
            # 升级前签发的旧会话没有 csrf：直接作废，让前端重新登录
            auth = self.headers.get("Authorization") or ""
            tk = auth[7:] if auth.startswith("Bearer ") else ""
            if tk:
                with conn() as c:
                    c.execute("DELETE FROM sessions WHERE token=?", (tk,))
            self.send_json({"ok": False, "code": "csrf_legacy",
                            "error": "登录状态已升级，请重新登录"}, 401)
            return True
        if secrets.compare_digest(have, want):
            return False
        self.send_json({"ok": False, "code": "csrf",
                        "error": "安全校验失败（CSRF），请刷新页面后重试"}, 403)
        return True

