    def settings_put(self, data):
        if self.need_auth() is None:
            return
        u = self.require()
        if not u:
            return
        if not self.need_perm(("people_edit",)):
            return
        if (u.get("role") or "") not in ("admin", SUPER_ROLE):
            return self.err(403, "只有管理员能改标题")
        if ("audit_days" in data) or ("audit_max" in data):
            try:
                days = max(1, int(data.get("audit_days") or 0)) if "audit_days" in data else None
                cap = max(100, int(data.get("audit_max") or 0)) if "audit_max" in data else None
            except (TypeError, ValueError):
                return self.err(400, "保留天数 / 条数上限要填整数")
            changed = []
            with conn() as c:
                if days is not None:
                    old = c.execute("SELECT v FROM settings WHERE k='audit_days'").fetchone()
                    if (old["v"] if old else "") != str(days):
                        c.execute("INSERT INTO settings(k,v) VALUES('audit_days',?)"
                                  " ON CONFLICT(k) DO UPDATE SET v=excluded.v", (str(days),))
                        changed.append("保留天数=%d" % days)
                if cap is not None:
                    old = c.execute("SELECT v FROM settings WHERE k='audit_max'").fetchone()
                    if (old["v"] if old else "") != str(cap):
                        c.execute("INSERT INTO settings(k,v) VALUES('audit_max',?)"
                                  " ON CONFLICT(k) DO UPDATE SET v=excluded.v", (str(cap),))
                        changed.append("上限=%d 条" % cap)
            if not changed:
                return self.send_json({"ok": True, "changed": False, "policy": audit_policy()})
            log("改日志策略", u["username"], "settings", "、".join(changed))
            return self.send_json({"ok": True, "changed": True, "policy": audit_policy()})
        title = (data.get("title") or "").strip()
        if not title:
            return self.err(400, "标题不能空")
        if len(title) > 60:
            return self.err(400, "标题最多 60 个字")
        with conn() as c:
            old = c.execute("SELECT v FROM settings WHERE k='title'").fetchone()
            if old and str(old["v"] or "") == title:
                return self.send_json({"ok": True, "title": title, "changed": False})
            c.execute("INSERT INTO settings(k,v) VALUES('title',?) ON CONFLICT(k) DO UPDATE SET v=excluded.v", (title,))
        bump_version()
        log("改标题", u["username"], "settings", title)
        return self.send_json({"ok": True, "title": title, "changed": True})

    def data_upsert(self, table, data):
