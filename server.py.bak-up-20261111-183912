    def register_send(self, data):
        import random
        if not signup_allow():
            return self.err(403, "本站未开放自助注册，请联系管理员建号")
        if signup_code() and (data.get("inv") or "").strip() != signup_code():
            return self.err(403, "邀请码不对，请向管理员索取")
        un = (data.get("username") or "").strip()
        pw = (data.get("pwd") or "").strip()
        uid = (data.get("uid") or "").strip()
        contact = (data.get("contact") or "").strip()
        if not (3 <= len(un) <= 20) or any(ch not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_" for ch in un):
            return self.err(400, "账号要 3–20 位字母/数字/下划线")
        _bad = pwd_problem(pw, un)
        if _bad:
            return self.err(400, _bad)
        if not uid:
            return self.err(400, "ID 必填")
        is_phone = contact.isdigit() and len(contact) == 11 and contact[0] == "1"
        is_mail = ("@" in contact) and ("." in contact.split("@")[-1]) and len(contact) <= 80
        if not (is_phone or is_mail):
            return self.err(400, "手机号或邮箱格式不对")
        ip = (self.client_ip() if self.client_address else "") or "?"
        ts_now = int(time.time())
        with conn() as c:
            c.execute("DELETE FROM send_log WHERE ts < ?", (ts_now - 86400 * 2,))
            last = c.execute("SELECT ts FROM send_log WHERE contact=? AND ip=? ORDER BY ts DESC LIMIT 1",
                             (contact, ip)).fetchone()
            if last and ts_now - int(last["ts"]) < SEND_COOLDOWN:
                return self.err(429, "验证码刚发过，%d 秒后再试" % (SEND_COOLDOWN - (ts_now - int(last["ts"]))))
            day_start = ts_now - (ts_now % 86400)
            cnt = c.execute("SELECT COUNT(*) AS n FROM send_log WHERE ip=? AND ts >= ?",
                            (ip, day_start)).fetchone()["n"]
            if cnt >= SEND_DAILY_IP:
                return self.err(429, "这个网络今天已经发过 %d 次验证码，明天再试或联系管理员" % SEND_DAILY_IP)
        code = "%06d" % random.randint(0, 999999)
        exp = ts_now + 600
        with conn() as c:
            if c.execute("SELECT 1 FROM users WHERE username=?", (un,)).fetchone():
                return self.err(409, "这个账号已被占用")
            c.execute("""INSERT INTO signups(username,pwd,uid,name,org,addr,contact,code,exp,ts)
                         VALUES(?,?,?,?,?,?,?,?,?,?)
                         ON CONFLICT(username) DO UPDATE SET pwd=excluded.pwd,uid=excluded.uid,
                         name=excluded.name,org=excluded.org,addr=excluded.addr,
                         contact=excluded.contact,code=excluded.code,exp=excluded.exp,ts=excluded.ts""",
                      (un, hash_pwd(pw), uid, data.get("name") or "", data.get("org") or "",
                       data.get("addr") or "", contact, code, exp, now()))
            c.execute("INSERT INTO send_log(ip,contact,un,ts) VALUES(?,?,?,?)",
                      (ip, contact, un, ts_now))
        log("申请注册", un, "signups", contact)
        return self.send_json({"ok": True, "code": code, "exp": exp, "mode": "trial",
                               "msg": "试行模式：验证码直接返回"})

