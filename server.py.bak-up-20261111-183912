    def version_publish(self, data):
        """仅超级管理员：把当前内部版本标记为对外发布版本。"""
        u = self.need_auth()
        if not u:
            return
        if u["role"] != SUPER_ROLE:
            return self.err(403, "只有超级管理员能发布版本")
        label = (data.get("label") or "").strip()
        note = (data.get("note") or "").strip()
        if not label:
            return self.err(400, "版本号不能为空")
        if len(label) > 24:
            return self.err(400, "版本号最多 24 个字符")
        if len(note) > 120:
            return self.err(400, "备注最多 120 个字符")
        with conn() as c:
            num = int(_meta(c, "version", 0) or 0)
            for k, v in (("pub_ver", label), ("pub_num", num), ("pub_at", now()),
                         ("pub_by", u["username"]), ("pub_note", note)):
                c.execute("INSERT INTO meta(k,v) VALUES(?,?)"
                          " ON CONFLICT(k) DO UPDATE SET v=excluded.v", (k, v))
        log("发布版本", u["username"], "%s（内部第 %d 版）" % (label, num))
        SSE.publish(num)
        return self.send_json({"ok": True, "pub": pub_info()})

