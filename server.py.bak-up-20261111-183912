                           (data.get("org") or "").strip(),
                           (data.get("perm_expire_at") or "").strip(),
                           (data.get("alliance") or "").strip(), now(), now()))
        except sqlite3.IntegrityError:
            return self.err(409, "登录名已存在")
        log("新增人员", u["username"], name, _role(data.get("role")))
        return self.send_json({"ok": True})

    def user_update(self, uid, data):
        if self.need_auth() is None:
            return
        u = self.need_perm(("people_edit",))
        if not u:
            return
        fields, args = [], []
        with conn() as c:
            tgt = c.execute("SELECT role, username FROM users WHERE id=?", (uid,)).fetchone()
        if not tgt:
            return self.err(404, "人员不存在")
        me = current_user(self)
        my_role = me.get("role") or ""
        tgt_role = tgt["role"] or ""
        is_top = my_role == SUPER_ROLE
        is_mgr = my_role in ("admin", SUPER_ROLE)
        if tgt_role == SUPER_ROLE and not is_top:
            return self.err(403, "超级管理员账号只有超级管理员能修改")
        if tgt_role == "admin" and not is_mgr:
            return self.err(403, "只有管理员能修改管理员账号")
        if data.get("password") and tgt_role in ("admin", SUPER_ROLE) and not is_mgr:
            return self.err(403, "只有管理员能修改管理员密码")
        if "role" in data and _role(data.get("role")) == SUPER_ROLE and not is_top:
            return self.err(403, "只有超级管理员能设置超级管理员")
        if "role" in data and _role(data.get("role")) == "admin" and not is_top:
            return self.err(403, "只有超级管理员能设置管理员角色")
        if tgt_role in ("admin", SUPER_ROLE) and (
                ("role" in data and _role(data.get("role")) not in ("admin", SUPER_ROLE))
                or ("status" in data and str(data.get("status") or "") != "在职")):
            with conn() as c2:
                n = c2.execute("SELECT COUNT(*) n FROM users WHERE role IN ('admin','superadmin')").fetchone()["n"]
            if n <= 1:
                return self.err(403, "这是唯一的管理员账号，不能降级或停用；先把别的账号设为管理员")
        gate = ("role", "perms", "status", "scope", "perm_expire_at", "org", "alliance")
        if not is_mgr and any(k in data for k in gate):
            return self.err(403, "只有管理员能改角色、权限和状态")
        if "perms" in data:
            fields.append("perms=?")
            args.append(",".join(parse_perms(data.get("perms"))))
        if "scope" in data:
            fields.append("scope=?")
            args.append(scope_of({"scope": data.get("scope")}))
        if "perm_expire_at" in data:
            fields.append("perm_expire_at=?")
            args.append((data.get("perm_expire_at") or "").strip())
        for k in ("role", "name", "squadron", "phone", "status", "note", "org", "alliance"):
            if k in data:
                fields.append(k + "=?")
                args.append(_role(data[k]) if k == "role" else data[k])
        if data.get("password"):
            fields.append("pwd=?")
            args.append(hash_pwd(data["password"]))
            fields.append("pwd_changed_at=?")
            args.append(now())
            if data.get("must_change"):
                fields.append("must_change=?")
                args.append(1)
        if not fields:
            return self.err(400, "没有要改的字段")
        # 与库里原值比一遍：没有任何字段变化就不写库、不写审计
        probe = {}
        for k in ("perms", "scope", "perm_expire_at", "role", "name", "squadron",
                  "phone", "status", "note", "org", "alliance"):
            if k in data:
                if k == "perms":
                    probe[k] = ",".join(parse_perms(data.get("perms")))
                elif k == "scope":
                    probe[k] = scope_of({"scope": data.get("scope")})
                elif k == "role":
                    probe[k] = _role(data[k])
                elif k == "perm_expire_at":
                    probe[k] = (data.get("perm_expire_at") or "").strip()
                else:
                    probe[k] = data[k]
        with conn() as c:
            cur_row = c.execute("SELECT * FROM users WHERE id=?", (uid,)).fetchone()
        if not cur_row:
            return self.err(404, "人员不存在")
        diff = diff_keys(cur_row, probe) if not data.get("password") else ["password"]
        if not diff:
            return self.send_json({"ok": True, "changed": False})
        fields.append("updated_at=?")
        args.append(now())
        args.append(uid)
        with conn() as c:
            cur = c.execute("UPDATE users SET " + ",".join(fields) + " WHERE id=?", args)
            if cur.rowcount == 0:
                return self.err(404, "人员不存在")
        log("修改人员", u["username"], tgt["username"] or ("user#%d" % uid),
            "、".join(sorted(diff)))
        return self.send_json({"ok": True, "changed": len(diff)})

    def user_delete(self, uid):
        if self.need_auth() is None:
            return
        u = self.need_perm(("people_edit",))
        if not u:
            return
        if uid == u["id"]:
            return self.err(400, "不能删除自己")
        with conn() as c:
            r = c.execute("SELECT username, role FROM users WHERE id=?", (uid,)).fetchone()
            if not r:
                return self.err(404, "人员不存在")
            if r["role"] == SUPER_ROLE and (u.get("role") or "") != SUPER_ROLE:
                return self.err(403, "超级管理员账号只有超级管理员能删除")
            if r["role"] in ("admin", SUPER_ROLE):
                n = c.execute("SELECT COUNT(*) n FROM users WHERE role IN ('admin','superadmin')").fetchone()["n"]
                if n <= 1:
                    return self.err(403, "这是唯一的管理员账号，不能删除；先把别的账号设为管理员")
        if not self.need_conf(r["username"]):
            return
        with conn() as c:
            c.execute("DELETE FROM users WHERE id=?", (uid,))
            c.execute("DELETE FROM sessions WHERE user=?", (uid,))
        log("删除人员", u["username"], r["username"])
        return self.send_json({"ok": True})


class QuietServer(ThreadingHTTPServer):
    daemon_threads = True

    def handle_error(self, request, client_address):
        import sys
        et = sys.exc_info()[0]
        if et in (ConnectionResetError, ConnectionAbortedError, BrokenPipeError, TimeoutError):
            return
        super().handle_error(request, client_address)


DEFAULT_ADMIN_PWDS = ("admin123", "Fleet#2026", "123456", "viewer123", "editor123")


def ensure_initial_passwords():
    """交付/首次运行：凡是还在用出厂口令的账号，一律换成一次性随机口令。

    同一个包发给多个人也互不相通；口令写在数据目录的「初始口令.txt」里，
    首次登录会强制修改，改完这个文件就可以删掉。
    """
    out = []
    with conn() as c:
        rows = c.execute("SELECT id,username,pwd,role FROM users ORDER BY id").fetchall()
        for r in rows:
            if not any(check_pwd(p, r["pwd"]) for p in DEFAULT_ADMIN_PWDS):
                continue
            pwd = secrets.token_urlsafe(8)
            c.execute("UPDATE users SET pwd=?, must_change=1, updated_at=? WHERE id=?",
                      (hash_pwd(pwd), now(), r["id"]))
            out.append((r["username"], r["role"], pwd))
    if not out:
        return []

    role_cn = {"admin": "管理员", "editor": "编辑", "viewer": "只读"}
    txt = os.path.join(DATA_DIR, "初始口令.txt")
    lines = ["FleetTool 初始账号（首次登录后必须修改口令）", ""]
    for un, role, pwd in out:
        lines.append("  账号：%-12s 口令：%-14s %s" % (un, pwd, role_cn.get(role, role)))
    lines.append("")
    lines.append("改完口令后，这个文件可以删掉。")
    body = "\n".join(lines) + "\n"
    try:
        with open(txt, "w", encoding="utf-8") as f:
            f.write(body)
    except OSError:
        txt = "(无法写入初始口令文件)"
    print("=" * 60)
    print(body.rstrip())
    print("-" * 60)
    print("已写入：%s" % txt)
    print("=" * 60)
    return out


def open_browser(url):
    try:
        import webbrowser
        webbrowser.open(url)
    except Exception:
        pass


def main():
    # 兜底：唯一管理员忘了密码、网页里没人能批的时候，在服务器本机执行
    #   python server.py --reset-pwd <账号> [新口令]
    if len(sys.argv) >= 3 and sys.argv[1] == "--reset-pwd":
        who = (sys.argv[2] or "").strip()
        newpw = (sys.argv[3] if len(sys.argv) >= 4 else "").strip() or secrets.token_urlsafe(9)
        init_db()
        with conn() as c:
            row = c.execute("SELECT id FROM users WHERE username=?", (who,)).fetchone()
            if not row:
                print("没有这个账号：%s" % who)
                return 3
            c.execute("UPDATE users SET pwd=?, must_change=1, updated_at=?, pwd_changed_at=? WHERE id=?",
                      (hash_pwd(newpw), now(), now(), row["id"]))
        log("命令行重置密码", "cli", who, "本地兜底，需下次登录改密")
        print("已重置 %s 的口令：%s" % (who, newpw))
        print("（这个口令只能用一次，登录后会强制改密码）")
        return 0
    # 只有在「第一次运行、data.db 还不存在」时才轮换出厂口令：
    # 交付出去的新库由程序自己生成，口令变成随机值写进初始口令.txt；
    # 已经有库的情况下（自己用、或者别人已经在用）每次启动都不再动口令。
    # 需要强制重新轮换时设 FT_ROTATE=1。
    first_run = not os.path.exists(DB_PATH)
    init_db()
    if os.environ.get("FT_ROTATE") == "1" or (FROZEN and first_run):
        ensure_initial_passwords()
    srv = None
    port = PORT
    for i in range(0, 21):
        try:
            srv = QuietServer((HOST, port), Handler)
            break
        except OSError as e:
            if i == 20:
                print("端口 %d~%d 都被占用：%s" % (PORT, PORT + 20, e))
                return 2
            port += 1
    url = "http://%s:%d/" % ("127.0.0.1" if HOST in ("0.0.0.0", "::") else HOST, port)
    print("FleetTool v%s 已启动：%s（数据库结构 v%d）" % (VERSION, url, SCHEMA_VERSION))
    print("数据目录：%s" % DATA_DIR)
    print("关闭这个窗口即停止服务。")
    if IDLE_EXIT:
        print("页面全关掉后 %d 秒自动退出（改 FT_IDLE_SEC 调时长，FT_IDLE_EXIT=0 关闭）。" % IDLE_SEC)
        threading.Thread(target=idle_watchdog, daemon=True).start()
    threading.Thread(target=audit_janitor, daemon=True).start()
    if FROZEN or os.environ.get("FT_OPEN") == "1":
        threading.Timer(1.2, open_browser, args=(url,)).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
