def parse_perms(raw):
    if isinstance(raw, (list, tuple, set)):
        got = [str(x).strip() for x in raw if str(x).strip()]
    else:
        got = [x.strip() for x in str(raw or "").split(",") if x.strip()]
    out = []
    for x in got:
        for k in LEGACY_PERMS.get(x, (x,)):
            if k in ALL_PERMS and k not in out:
                out.append(k)
    return [x for x in ALL_PERMS if x in out]


def safe_user(d):
    if not d:
        return None
    d = dict(d)
    d.pop("pwd", None)
    d["scope"] = scope_of(d)
    exp = str(d.get("perm_expire_at") or "").strip()
    d["perm_expired"] = bool(exp and exp[:10] < time.strftime("%Y-%m-%d"))
    if d.get("role") == SUPER_ROLE:
        d["perms"] = list(ALL_PERMS)
    elif d.get("role") == "admin":
        saved = [k for k in ALL_PERMS if k in set(parse_perms(d.get("perms")))]
        d["perms"] = saved or list(ALL_PERMS)
    else:
        d["perms"] = [k for k in ALL_PERMS if k in perms_of(d)]
