def prune_member_history(days=None, archive=True):
    """按保留期清人员轨迹；__init__ 基线永久保留。删除前按月归档。"""
    d = mh_policy() if days is None else max(0, int(days))
    if d <= 0:
        return {"kept": True, "deleted": 0, "days": 0, "archives": []}
    cut = (datetime.now() - timedelta(days=d)).strftime("%Y-%m-%d %H:%M:%S")
    with conn() as c:
        rows = [dict(r) for r in c.execute(
            "SELECT * FROM member_history WHERE ts<? AND IFNULL(field,'')<>'__init__'", (cut,))]
    if not rows:
        return {"deleted": 0, "days": d, "archives": []}
    files = []
    if archive:
        by_month = {}
        for r in rows:
            by_month.setdefault(str(r.get("ts") or "")[:7] or "unknown", []).append(r)
        if not os.path.isdir(LOG_DIR):
            os.makedirs(LOG_DIR, exist_ok=True)
        for ym, items in by_month.items():
            fp = os.path.join(LOG_DIR, "member_history-%s.jsonl" % ym)
            with io.open(fp, "a", encoding="utf-8", newline="\n") as f:
                for it in items:
                    f.write(json.dumps(it, ensure_ascii=False) + "\n")
            files.append(os.path.basename(fp))
    with conn() as c:
        c.execute("DELETE FROM member_history WHERE ts<? AND IFNULL(field,'')<>'__init__'", (cut,))
    log("归档清理人员轨迹", "system", "member_history",
        "删除 %d 条（早于 %s）" % (len(rows), cut[:10]))
    return {"deleted": len(rows), "days": d, "archives": files}


