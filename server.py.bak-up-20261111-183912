    def sse(self):
        q = parse_qs(urlparse(self.path).query)
        tk = (q.get("ticket", [""])[0] or "").strip()
        who = use_ticket(tk)
        if not who:
            return self.err(401, "实时连接需要有效的一次性 ticket（刷新页面重试）")
        if SSE.count() >= SSE_MAX_CLIENTS:
            return self.send_json({"ok": False, "code": "sse_full",
                                   "error": "实时刷新连接已满，手动刷新页面即可看到最新数据"}, 503)
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "close")
        self.end_headers()
        q = SSE.add()
        live_add(1)
        try:
            self.wfile.write(("event: version\ndata: %d\n\n" % get_version()).encode())
            self.wfile.flush()
            deadline = time.time() + 3600
            while time.time() < deadline:
                touch()
                try:
                    ver = q.get(timeout=25)
                    self.wfile.write(("event: version\ndata: %d\n\n" % ver).encode())
                except queue.Empty:
                    self.wfile.write(b": ping\n\n")
                self.wfile.flush()
        except Exception:
            pass
        finally:
            SSE.drop(q)
            live_add(-1)

    def login(self, data):
        name = (data.get("username") or "").strip()
        pwd = data.get("password") or ""
        ip = (self.client_address[0] if self.client_address else "") or "?"
        wait = login_wait(ip, name)
        if wait:
            log("登录失败", name, ip, "锁定中，还需 %d 秒" % wait)
            return self.send_json({"ok": False, "code": "locked",
                                   "error": "登录失败次数太多，请 %d 秒后再试" % wait}, 429)
        with conn() as c:
            r = c.execute("SELECT * FROM users WHERE username=?", (name,)).fetchone()
            if not r or not check_pwd(pwd, r["pwd"]):
                left = login_failed(ip, name)
                log("登录失败", name, ip, "密码错误" + ("，已锁定 %d 秒" % left if left else ""))
                msg = "用户名或密码错误" if not left else "登录失败次数太多，请 %d 秒后再试" % left
                return self.send_json({"ok": False, "error": msg,
                                       "code": "locked" if left else "bad_pwd"}, 401)
            if (r["status"] or "") not in ("在职", ""):
                return self.err(403, "账号已停用")
            token = secrets.token_hex(16)
            csrf = secrets.token_urlsafe(24)
            now_ts = int(time.time())
            c.execute("DELETE FROM sessions WHERE expire<?", (now_ts,))
            c.execute("INSERT INTO sessions(token,user,expire,csrf) VALUES(?,?,?,?)",
                      (token, r["id"], now_ts + SESSION_HOURS * 3600, csrf))
            # 注意：同一秒内登录多次时 expire 会相同，必须用 rowid 兜底排序，
            # 否则刚签发的 token 可能被当成“旧的”删掉，用户登录后立刻 401。
            c.execute("DELETE FROM sessions WHERE user=? AND token NOT IN "
                      "(SELECT token FROM sessions WHERE user=? ORDER BY expire DESC, rowid DESC LIMIT 3)",
                      (r["id"], r["id"]))
        login_ok(ip, name)
        if not (r["uid"] or "").strip():
            _g = guess_uid(None, r["username"], dict(r).get("phone"))
            if _g:
                # 必须自己开 with：上面 with 块已提交，继续用 c 会留下未提交的写事务，
                # 之后所有写操作都会 database is locked。
                with conn() as c2:
                    c2.execute("UPDATE users SET uid=? WHERE id=?", (_g, r["id"]))
                r = dict(r)
                r["uid"] = _g
        log("登录", name, "session")
        return self.send_json({"ok": True, "token": token, "csrf": csrf,
                               "user": safe_user(dict(r))})

