_alock = threading.Lock()


def touch():
    _last_seen[0] = time.time()


def live_add(n):
    with _alock:
        _live[0] = max(0, _live[0] + n)
    touch()


def idle_watchdog():
    while True:
        time.sleep(2)
        with _alock:
            live = _live[0]
        if live == 0 and (time.time() - _last_seen[0]) > IDLE_SEC:
            print("")
            print("[自动退出] 已经 %d 秒没有页面连接，服务停止。" % IDLE_SEC)
            print("           下次双击 start.cmd 即可重新打开。")
            sys.stdout.flush()
            os._exit(0)

def now():
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


def hash_pwd(pwd, salt=None):
    salt = salt or secrets.token_hex(8)
    return salt + "$" + hashlib.pbkdf2_hmac("sha256", pwd.encode(), salt.encode(), 120000).hex()


def check_pwd(pwd, stored):
    try:
        salt = stored.split("$", 1)[0]
    except (AttributeError, ValueError):
        return False
    return hash_pwd(pwd, salt) == stored


