_TICKETS = {}
_TLOCK = threading.Lock()


def issue_ticket(username):
    tk = secrets.token_urlsafe(18)
    with _TLOCK:
        now_ts = time.time()
        for k in [k for k, v in _TICKETS.items() if v[1] < now_ts]:
            _TICKETS.pop(k, None)
        _TICKETS[tk] = (username, now_ts + TICKET_TTL)
    return tk


def use_ticket(tk):
    """一次性：取出即删；过期或不存在返回 None"""
    if not tk:
        return None
    with _TLOCK:
        v = _TICKETS.pop(tk, None)
    if not v or v[1] < time.time():
        return None
    return v[0]
